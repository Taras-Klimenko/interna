# Локальная разработка: база из docker-compose.yml в корне (`pnpm db:up`).
DATABASE_URL="postgresql://interna:interna_dev@127.0.0.1:5433/interna?schema=public"
PORT=3000
# Откуда разрешены запросы (через запятую). В разработке клиент ходит через прокси Vite, так что CORS не нужен.
CORS_ORIGINS=""

# Разговор с персонажем. Без ключа чат выключен, остальное работает.
# Провайдер модели: kimi (Moonshot, по умолчанию) или anthropic (Claude).
CHAT_PROVIDER="kimi"
# Модель; пусто — kimi-k3.1-pro для kimi, claude-opus-5-5 для anthropic.
CHAT_MODEL=""
# Ключ Moonshot: https://platform.kimi.ai → API Keys.
MOONSHOT_API_KEY="sk-ms-f1dIQCfqvOstOArEtFltFSUvMeZlrAktZa9hwMpuUrKlnY6wHMeUHJIM"
# Ключ Anthropic — если CHAT_PROVIDER="anthropic".
ANTHROPIC_API_KEY=""
# Сколько сообщений один человек может отправить за сутки.
CHAT_DAILY_LIMIT=100
