// Схема базы Interna. После изменений: `pnpm --filter @interna/server db:migrate`.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  // Сервер собирается обычным tsc в .js — импорты внутри клиента тоже должны быть .js.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Тестировщик. Регистрации нет: человек входит по инвайт-коду, первый вход создаёт пользователя.
model User {
  id        String    @id @default(uuid())
  name      String    @default("")
  createdAt DateTime  @default(now())
  invite    Invite?
  sessions  Session[]
  world     World?
  chat      ChatMessage[]
  llmCalls  LlmCall[]
}

/// Инвайт-код. Он же ключ для входа с другого устройства: тот же код — тот же пользователь.
model Invite {
  code      String    @id
  /// Для кого код (видно только в базе), например «Аня, тестировщица».
  note      String    @default("")
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  userId    String?   @unique
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
}

/// Вход с конкретного устройства. В базе только хэш токена: утёкшая база не даёт войти.
model Session {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String   @default("")
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

/// Мир пользователя целиком, одним JSON-документом. version растёт с каждым сохранением:
/// по нему видно, что мир успели поменять с другого устройства.
model World {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Json
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
}

/// Реплика в разговоре с персонажем. Сохраняется парой (вопрос и ответ), когда ответ дописан до конца.
model ChatMessage {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// user — хозяин комнаты, assistant — персонаж.
  role      String
  text      String
  /// Что персонаж сделал в комнате вместе с этим ответом (включил свет, полил растение…): [{type, objectId, …}].
  actions   Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// Каждый вызов языковой модели: сколько токенов ушло и сколько это заняло. По этой таблице считаем стоимость.
model LlmCall {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Зачем вызывали: пока только chat.
  kind         String
  provider     String
  model        String
  /// Входные токены без тех, что пришли из кэша.
  inputTokens  Int      @default(0)
  cachedTokens Int      @default(0)
  /// Выходные токены вместе с «размышлениями» модели.
  outputTokens Int      @default(0)
  durationMs   Int      @default(0)
  /// Текст ошибки, если вызов не удался.
  error        String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}
