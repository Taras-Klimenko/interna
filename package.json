{
  "name": "interna",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm --filter @interna/client dev",
    "dev:server": "pnpm --filter @interna/server dev",
    "db:up": "docker compose up -d",
    "db:down": "docker compose stop",
    "db:migrate": "pnpm --filter @interna/server db:migrate",
    "invite": "pnpm --filter @interna/server invite",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "assets:characters": "node assets/scripts/build-characters.mjs",
    "assets:furniture": "node assets/scripts/build-furniture.mjs",
    "assets:nature": "node assets/scripts/build-nature.mjs",
    "assets:inspect": "node assets/scripts/inspect.mjs"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "meshoptimizer": "^1.3.0",
    "obj2gltf": "3.2.0",
    "sharp": "^0.35.5",
    "typescript": "7.0.2"
  }
}
